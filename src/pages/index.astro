---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { SITE, socialLinks } from '../lib/site';
import { getEntries, getProjects } from '../lib/content';

const projects = (await getProjects()).slice(0, 4);
const posts = (await getEntries('blog')).slice(0, 4);
const journal = (await getEntries('journal')).slice(0, 2);
const links = socialLinks();

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    address: { '@type': 'PostalAddress', addressLocality: SITE.location },
    ...(SITE.email ? { email: SITE.email } : {}),
};
---

<BaseLayout title={SITE.name} jsonLd={jsonLd}>
    <div class="container container--narrow">
        <section class="intro">
            <p>{SITE.intro}</p>
            <p class="intro__contact">
                {SITE.email && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
                {
                    links.map((link) => (
                        <a href={link.url} rel="me noopener" target="_blank">
                            {link.name}
                        </a>
                    ))
                }
            </p>
        </section>

        {
            projects.length > 0 && (
                <section class="group">
                    <h2 class="group__head">Projects</h2>
                    <ul class="rows">
                        {projects.map((project) => (
                            <ProjectRow project={project} />
                        ))}
                    </ul>
                    <a class="more" href="/projects/">All projects</a>
                </section>
            )
        }

        {
            posts.length > 0 && (
                <section class="group">
                    <h2 class="group__head">Writing</h2>
                    <ul class="rows">
                        {posts.map((entry) => (
                            <EntryRow entry={entry} tagBase="/blog/tag/" />
                        ))}
                    </ul>
                    <a class="more" href="/blog/">All posts</a>
                </section>
            )
        }

        {
            journal.length > 0 && (
                <section class="group">
                    <h2 class="group__head">Journal</h2>
                    <ul class="rows">
                        {journal.map((entry) => (
                            <EntryRow entry={entry} />
                        ))}
                    </ul>
                    <a class="more" href="/journal/">All entries</a>
                </section>
            )
        }
    </div>
</BaseLayout>
