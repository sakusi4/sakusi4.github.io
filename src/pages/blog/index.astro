---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getEntries, getTagCounts, tagSlug } from '../../lib/content';

const entries = await getEntries('blog');
const tags = getTagCounts(entries);
---

<BaseLayout title="Blog" description="Notes on things I built and what they taught me.">
    <div class="container container--narrow">
        <h1 class="page-title">Blog</h1>
        {
            tags.length > 0 && (
                <p class="tag-row">
                    {tags.map(({ tag, count }) => (
                        <a href={`/blog/tag/${tagSlug(tag)}/`}>
                            {tag} <span class="tag-row__count">{count}</span>
                        </a>
                    ))}
                </p>
            )
        }
        {
            entries.length > 0 ? (
                <ul class="rows">
                    {entries.map((entry) => (
                        <EntryRow entry={entry} tagBase="/blog/tag/" />
                    ))}
                </ul>
            ) : (
                <p class="empty">
                    <code>src/content/blog/</code> 에 첫 글을 추가하세요.
                </p>
            )
        }
    </div>
</BaseLayout>
