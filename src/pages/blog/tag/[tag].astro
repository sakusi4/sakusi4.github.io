---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryRow from '../../../components/EntryRow.astro';
import { getEntries, getTagCounts, tagSlug, type Entry } from '../../../lib/content';

export async function getStaticPaths() {
    const entries = await getEntries('blog');
    return getTagCounts(entries).map(({ tag }) => ({
        params: { tag: tagSlug(tag) },
        props: { tag, entries: entries.filter((e) => e.data.tags.includes(tag)) },
    }));
}

interface Props {
    tag: string;
    entries: Entry[];
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={tag} description={`Posts about ${tag}.`}>
    <div class="container container--narrow">
        <a href="/blog/" class="back">← Blog</a>
        <h1 class="page-title">{tag}</h1>
        <ul class="rows">
            {entries.map((entry) => <EntryRow entry={entry} tagBase="/blog/tag/" />)}
        </ul>
    </div>
</BaseLayout>
