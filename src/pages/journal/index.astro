---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getEntries } from '../../lib/content';

const entries = await getEntries('journal');
---

<BaseLayout title="Journal" description="Dubai, cycling, and everything that isn't work.">
    <div class="container container--narrow">
        <h1 class="page-title">Journal</h1>
        {
            entries.length > 0 ? (
                <ul class="rows">
                    {entries.map((entry) => (
                        <EntryRow entry={entry} />
                    ))}
                </ul>
            ) : (
                <p class="empty">
                    <code>src/content/journal/</code> 에 첫 글을 추가하세요.
                </p>
            )
        }
    </div>
</BaseLayout>
