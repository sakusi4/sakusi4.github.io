---
import { formatDate, getReadingTime, tagSlug, type Entry } from '../lib/content';

interface Props {
    entry: Entry;
    /** blog만 태그 아카이브가 있다. */
    tagBase?: string | undefined;
}

const { entry, tagBase } = Astro.props;
const { title, date, description, tags } = entry.data;
const href = `/${entry.collection}/${entry.id}/`;
---

<li class="row">
    <p class="row__meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{getReadingTime(entry.body)} min</span>
        {
            tagBase &&
                tags.map((tag) => (
                    <a href={`${tagBase}${tagSlug(tag)}/`}>{tag}</a>
                ))
        }
    </p>
    <h2 class="row__title"><a href={href}>{title}</a></h2>
    {description && <p class="row__desc">{description}</p>}
</li>
